    {
      "name": "Usuário",
      "item": [
        {
          "name": "Novo Cadastro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Testes",
                  "// 1º TESTE: O código de status da resposta do teste é 201 (Criado):",
                  "pm.test(\"Status code é 201\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// 2º TESTE: Captura o _id da resposta e o armazene em uma variável de ambiente.",
                  "pm.test(\"Store _id in environment variable\", function () {",
                  "    pm.globals.set(\"userId\", pm.response.json()._id);",
                  "});",
                  "",
                  "// Validação do contrato",
                  "// Importa o validador",
                  "const Ajv = require('ajv');",
                  "// Configuração detalhada de erros",
                  "const ajv = new Ajv({allErrors: true, verbose: true});",
                  "",
                  "",
                  "// 3º TESTE: Validar se o retorno é um array de objetos conforme o modelo",
                  "pm.test('Schema is valid', function() {",
                  "    // Compara o modelo de schema com a resposta da API.",
                  "    const isValid = ajv.validate(pm.globals.get('schema'), pm.response.json());",
                  "    // Se não for válido, exibe \"Falha no Contrato\" e detalha o erro",
                  "    pm.expect(isValid, \"Falha no Contrato: \" + JSON.stringify(ajv.errors)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.globals.unset(\"schema\");",
                  "",
                  "pm.globals.set(\"schema\", {",
                  "  \"type\": \"object\",",
                  "  \"properties\": {",
                  "    \"message\": {",
                  "      \"type\": \"string\"",
                  "    }",
                  "  },",
                  "  \"required\": [",
                  "    \"message\"",
                  "  ]",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"nome\": \"{{userName}}\",\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\",\n    \"administrador\": \"false\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://serverest.dev/usuarios",
              "protocol": "https",
              "host": [
                "serverest",
                "dev"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Buscar Usuário pelo ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Testes",
                  "// 1º TESTE: Status Code:",
                  "pm.test(\"Status code é 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// 2º TESTE: Validar se o ID retornado é o esperado:",
                  "pm.test(\"Validar ID retornado\", () => {",
                  "    pm.expect(pm.response.json()._id).to.be.eql(pm.globals.get(\"userId\"))",
                  "});",
                  "",
                  "// 3º TESTE: Validar se o email retornado é o esperado:",
                  "pm.test(\"Validar email retornado\", () => {",
                  "    pm.expect(pm.response.json().email).to.be.eql(pm.globals.get(\"userEmail\"))",
                  "});",
                  "",
                  "// Importa o validador:",
                  "const Ajv = require('ajv');",
                  "// Configuração detalhada de erros:",
                  "const ajv = new Ajv({allErrors: true, verbose: true});",
                  "",
                  "// 4º TESTE: Validar se o retorno é um array de objetos conforme o modelo:",
                  "pm.test('Schema is valid', () => {",
                  "    // Compara o modelo de schema com a resposta da API:",
                  "    const isValid = ajv.validate(pm.globals.get(\"schema\"), pm.response.json());",
                  "    // Se não for válido, exibe \"Falha no Contrato\" e detalha o erro:",
                  "    pm.expect(isValid, \"Falha no Contrato: \" + JSON.stringify(ajv.errors)).to.be.true;",
                  "});",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Limpa a variável antes de usá-la:",
                  "pm.globals.unset(\"schema\");",
                  "// Schema JSON que será comparado com o body do response:",
                  "pm.globals.set(\"schema\", {",
                  "  \"type\": \"object\",",
                  "  \"properties\": {",
                  "    \"nome\": {",
                  "      \"type\": \"string\"",
                  "    },",
                  "    \"email\": {",
                  "      \"type\": \"string\"",
                  "    },",
                  "    \"password\": {",
                  "      \"type\": \"string\"",
                  "    },",
                  "    \"administrador\": {",
                  "      \"type\": \"string\"",
                  "    },",
                  "    \"_id\": {",
                  "      \"type\": \"string\"",
                  "    }",
                  "  },",
                  "  \"required\": [",
                  "    \"nome\",",
                  "    \"email\",",
                  "    \"password\",",
                  "    \"administrador\",",
                  "    \"_id\"",
                  "  ]",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
